PORT=3001
# Em produção, NODE_ENV=production exige JWT_SECRET e não cria contas padrão
NODE_ENV=development
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio
JWT_EXPIRES_IN=7d
# Proxies à frente da API (Render = 1). Padrão: 1 em produção, 0 em desenvolvimento.
# Sem isso, o limite de tentativas de login vale para o IP do proxy e bloqueia todos os usuários.
# TRUST_PROXY=1
# Origens do frontend que podem chamar a API (separadas por vírgula)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DATABASE_FILE=./data/labmu.sqlite
DEFAULT_ADMIN_EMAIL=admin.musarq@unicap.br
DEFAULT_ADMIN_PASSWORD=Admin@123
DEFAULT_TECH_EMAIL=tecnico.musarq@unicap.br
DEFAULT_TECH_PASSWORD=Tecnico@123
# Produção (NODE_ENV=production): sem contas padrão. Na primeira subida, cria o administrador abaixo
# se nenhum administrador existir. Remova a senha do ambiente depois do primeiro login.
# INITIAL_ADMIN_EMAIL=
# INITIAL_ADMIN_PASSWORD=
