PORT=3001
NODE_ENV=development
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio
JWT_EXPIRES_IN=7d

DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@[POOLER_HOST]:5432/postgres

PG_POOL_MAX=1
PGSSL_CA_PATH=./certs/prod-ca-2021.crt
PGSSL_REJECT_UNAUTHORIZED=true

TRUST_PROXY=1
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

DEFAULT_ADMIN_EMAIL=admin.musarq@unicap.br
DEFAULT_ADMIN_PASSWORD=defina-uma-senha-segura
DEFAULT_TECH_EMAIL=tecnico.musarq@unicap.br
DEFAULT_TECH_PASSWORD=defina-uma-senha-segura