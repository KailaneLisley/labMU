PORT=3001
# Em produção, NODE_ENV=production exige JWT_SECRET e não cria contas padrão
NODE_ENV=development
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio
JWT_EXPIRES_IN=7d
# Vercel/Supabase: use a URI de Transaction pooler em Supabase > Connect.
# Substitua os placeholders; nunca publique a senha nem envie DATABASE_URL ao frontend.
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@[POOLER_HOST]:6543/postgres?sslmode=require
# Pool pequeno para execução serverless.
PG_POOL_MAX=1
# Opcional: PGSSL_REJECT_UNAUTHORIZED=false somente para diagnóstico temporário, nunca como padrão.
# PGSSL_REJECT_UNAUTHORIZED=true
# Proxies à frente da API. Em produção, Vercel normalmente fica atrás de um proxy.
TRUST_PROXY=1
# Origens do frontend que podem chamar a API (separadas por vírgula)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Credenciais de seed usadas apenas em desenvolvimento (não usar em produção)
DEFAULT_ADMIN_EMAIL=admin.musarq@unicap.br
DEFAULT_ADMIN_PASSWORD=Admin@123
DEFAULT_TECH_EMAIL=tecnico.musarq@unicap.br
DEFAULT_TECH_PASSWORD=Tecnico@123
# Em produção, crie o primeiro administrador com estas variáveis e remova a senha após o primeiro login.
# INITIAL_ADMIN_EMAIL=
# INITIAL_ADMIN_PASSWORD=
